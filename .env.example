# Server
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development
APP_DEBUG=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Paths
PDF_DATA_DIR=./data/books
BOOKS_DIR=./data/books
CHROMA_DB_DIR=./data/chroma_db

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# LLM
LLM_MODEL_NAME=google/flan-t5-large
SUMMARISER_MODEL_NAME=facebook/bart-large-cnn
LLM_DEVICE=cpu
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1

# RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=8
CHROMA_COLLECTION_NAME=talal_books
TOPIC_SIMILARITY_THRESHOLD=0.30

# Logging
LOG_LEVEL=INFO