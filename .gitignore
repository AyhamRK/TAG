# ─────────────────────────────────────────────
# Environment & Secrets
# ─────────────────────────────────────────────
.env
.env.local
.env.production
*.pem
*.key

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ─────────────────────────────────────────────
# Node / React
# ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.npm
frontend/build/

# ─────────────────────────────────────────────
# VS Code
# ─────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# ─────────────────────────────────────────────
# AI / ML Model Artifacts
# ─────────────────────────────────────────────
# Cached HuggingFace model weights (large binaries — download at runtime)
backend/models/
~/.cache/huggingface/

# ChromaDB persistent store (rebuilt from PDFs)
backend/data/chroma_db/*
!backend/data/chroma_db/.gitkeep

# ─────────────────────────────────────────────
# PDF Book Files (often large / licensed content)
# ─────────────────────────────────────────────
backend/data/pdfs/*.pdf
# Keep the placeholder so Git tracks the folder
!backend/data/pdfs/.gitkeep

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
*.log
logs/

# ─────────────────────────────────────────────
# OS Files
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────
# Jupyter (if used for experimentation)
# ─────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
